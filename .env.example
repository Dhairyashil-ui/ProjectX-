# ====================================================================
# GitStory AI - Environment Variables Template
# Provide your credentials below. Never commit real keys to source control.
# ====================================================================

# Groq Cloud API Key for AI Natural Language Q&A (from console.groq.com)
GROQ_API_KEY=

# Default Groq model identifier
GROQ_MODEL=qwen/qwen3.8-27b

# GitHub Personal Access Token (PAT) or GitHub App Token
# Used server-side for all features (Collaborators, Timeline, Code, AI)
# Increases rate limits from 60 req/hr to 5,000 req/hr
GITHUB_TOKEN=

# Optional: Server Port for standalone Node server
PORT=3001
